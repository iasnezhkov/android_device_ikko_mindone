service vendor.camera-provider-mindone /vendor/bin/hw/android.hardware.camera.provider-service.mindone
    class hal
    user cameraserver
    group audio camera input drmrpc sdcard_rw system media graphics
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance

on post-fs-data
    mkdir /data/vendor/camera 0755 root root

on early-boot
    chown cameraserver camera /sys/devices/platform/soc/11eb1000.i2c/i2c-4/4-0069/mode
    chmod 0664 /sys/devices/platform/soc/11eb1000.i2c/i2c-4/4-0069/mode

on property:vendor.all.modules.ready=1
    chown cameraserver camera /sys/devices/platform/soc/11eb1000.i2c/i2c-4/4-0069/mode
    chmod 0664 /sys/devices/platform/soc/11eb1000.i2c/i2c-4/4-0069/mode

on early-boot && property:persist.vendor.camera.maxres=*
    chown cameraserver camera /sys/module/imgsensor_isp6s/parameters/imx766_4cell
    chmod 0664 /sys/module/imgsensor_isp6s/parameters/imx766_4cell

on property:persist.vendor.camera.maxres=*
    chown cameraserver camera /sys/module/imgsensor_isp6s/parameters/imx766_4cell
    chmod 0664 /sys/module/imgsensor_isp6s/parameters/imx766_4cell
