service vendor.camera-provider-mindone /vendor/bin/hw/android.hardware.camera.provider-service.mindone
    class hal
    user cameraserver
    group audio camera input drmrpc sdcard_rw system media graphics
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance
