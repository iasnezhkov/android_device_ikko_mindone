# FM Radio — MT6631/6635 chip family, confirmed on this device
# (fmradio_drv_mt6631_6635.ko loads live, F3308).
ro.fm.chip=0x6631
ro.fm.band=1
ro.fm.low_band=875
ro.fm.high_band=1080
ro.fm.seek_space=1
ro.fm.max_scan_num=40
ro.fm.seek_lev=4
ro.fm.scan_sort=0
ro.fm.short_ana_sup=1
ro.fm.rssi_th_l2=-102
ro.fm.noise_floor_detect=true
ro.fm.fake_chans=4
ro.fm.fake_chan_0=921 -205
ro.fm.fake_chan_1=960 -152
ro.fm.fake_chan_2=1040 -152
ro.fm.fake_chan_3=1075 -205

# 13.09 log flood (LOG-REVIEW-1309): per-UID socket teardown accounting, ~650/min at D level
log.tag.InetDiagMessage=SILENT
