allow hal_tetheroffload_default mddp_device:chr_file { getattr open read write ioctl };
allowxperm hal_tetheroffload_default mddp_device:chr_file ioctl { 0x0000 };
allow hal_tetheroffload_default self:netlink_route_socket { create bind read write setopt nlmsg_read nlmsg_getneigh };
allow hal_tetheroffload_default self:udp_socket { create ioctl };

allow hal_tetheroffload_default { system_server network_stack }:fd use;
allow hal_tetheroffload_default { system_server network_stack }:netlink_netfilter_socket { getattr getopt read };
type sysfs_mindone_mddp, fs_type, sysfs_type;
allow hal_tetheroffload_default sysfs_mindone_mddp:file { open read getattr };
