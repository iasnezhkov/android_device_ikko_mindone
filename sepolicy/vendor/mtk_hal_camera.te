dontaudit mtk_hal_camera default_prop:file { read open getattr map };

hal_client_domain(mtk_hal_camera, hal_camera)

get_prop(mtk_hal_camera, vendor_mindone_camera_prop)

allow mtk_hal_camera vendor_camera_color_file:dir r_dir_perms;
allow mtk_hal_camera vendor_camera_color_file:file r_file_perms;

allow mtk_hal_camera fwk_sensor_service:service_manager find;

allow mtk_hal_camera input_device:dir r_dir_perms;
allow mtk_hal_camera input_device:chr_file r_file_perms;
allow mtk_hal_camera sysfs_mindone_hall:file r_file_perms;

allow mtk_hal_camera sysfs_mindone_camera_4cell:file rw_file_perms;
allow mtk_hal_camera sysfs_mindone_ois:file rw_file_perms;
