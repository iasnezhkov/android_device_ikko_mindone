type mindone_gauged, domain;
type mindone_gauged_exec, exec_type, vendor_file_type, file_type;
type mindone_gauge_data_file, file_type, data_file_type;

init_daemon_domain(mindone_gauged)

allow mindone_gauged self:netlink_socket { create bind read write };
allow mindone_gauged sysfs_batteryinfo:dir search;
allow mindone_gauged sysfs_batteryinfo:file { getattr open read };
allow mindone_gauged sysfs_batteryinfo:lnk_file read;
allow mindone_gauged mindone_gauge_data_file:dir { search open read write add_name remove_name };
allow mindone_gauged mindone_gauge_data_file:file { create open read write append getattr rename unlink };
get_prop(mindone_gauged, vendor_mindone_gauge_config_prop)
