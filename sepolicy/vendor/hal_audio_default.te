allow hal_audio_default vow_device:chr_file { getattr open read write ioctl };
allowxperm hal_audio_default vow_device:chr_file ioctl {
    0x5603 0x5604 0x5605 0x5609 0x560a 0x560b 0x560c
    0x560d 0x560e 0x560f 0x5610 0x5611 0x5612 0x5613 0x5617
};
