;; mindone - CIL equivalent of sepolicy/vendor/*.te for repackaging without soong (appended to the end
;; of VENDOR/etc/selinux/vendor_sepolicy.cil; precompiled_sepolicy is removed, init compiles the CIL).
(genfscon sysfs "/devices/platform/eta6965_chg/power_supply" (u object_r sysfs_batteryinfo ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/10026000.pwrap/10026000.pwrap:mt6366/mtk-charger-detection/power_supply" (u object_r sysfs_batteryinfo ((s0) (s0))))
(allow mtk_hal_c2 custom_version_prop (file (read open getattr map)))
(typeattributeset proc_type (proc_battery_cmd))
(allow hal_keymint_default tkcore_admin_device (chr_file (read write open ioctl)))
(typeattributeset proc_type (proc_aed))
(allow vendor_init mtk_radio_device (lnk_file (unlink)))
(genfscon sysfs "/devices/virtual/hf_manager/hf_manager/sar_cali/wakeup" (u object_r sysfs_wakeup ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/11eb0000.i2c/i2c-2/2-0058/wakeup" (u object_r sysfs_wakeup ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/10026000.pwrap/10026000.pwrap:mt6366/mtk-charger-detection/power_supply/mtk_charger_type/wakeup" (u object_r sysfs_wakeup ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/1101a000.i2c/i2c-6/6-004e/wakeup" (u object_r sysfs_wakeup ((s0) (s0))))
(genfscon sysfs "/devices/platform/charger/power_supply/pdpe-state/wakeup" (u object_r sysfs_wakeup ((s0) (s0))))
(genfscon sysfs "/devices/platform/charger/power_supply/cw-bat/wakeup" (u object_r sysfs_wakeup ((s0) (s0))))
(genfscon sysfs "/devices/platform/charger/power_supply/usb/wakeup" (u object_r sysfs_wakeup ((s0) (s0))))
(genfscon sysfs "/devices/platform/eta6965_chg/power_supply/eta6965_chg/wakeup" (u object_r sysfs_wakeup ((s0) (s0))))
(allow hal_gatekeeper_default hal_gatekeeper_hwservice (hwservice_manager (find)))
(allow hal_fingerprint_default hal_fingerprint_hwservice (hwservice_manager (find)))
(allow mtk_hal_camera hal_camera_hwservice (hwservice_manager (find)))
(genfscon sysfs "/devices/virtual/hf_manager/hf_manager/sar_cali" (u object_r sysfs_batteryinfo ((s0) (s0))))
(typetransition hal_fingerprint_default vendor_data_file dir "silead" fingerprint_vendor_data_file)
(allow hal_fingerprint_default vendor_data_file (dir (search write add_name)))
(allow hal_fingerprint_default fingerprint_vendor_data_file (dir (create open read write search add_name remove_name getattr setattr rmdir)))
(allow hal_fingerprint_default fingerprint_vendor_data_file (file (create open read write getattr setattr unlink rename append map lock ioctl)))
(allow hal_fingerprint_default sysfs_batteryinfo (dir (search)))
(allow hal_fingerprint_default sysfs_batteryinfo (file (read open getattr)))
(allow system_server sysfs_vibrator (file (read open getattr)))
(allow fuelgauged_nvram sysfs_dt_firmware_android (dir (search)))
(allow fuelgauged_nvram sysfs_dt_firmware_android (file (read open getattr)))
(allow init debugfs_bootreceiver_tracing (dir (write add_name)))

(dontaudit mtk_hal_camera default_prop (file (read open getattr map)))
(dontaudit mtk_hal_c2 misctrl_prop (file (read open getattr map)))
(dontaudit mtk_hal_c2 logdr_socket (sock_file (write)))
(dontaudit mediacodec default_prop (file (read open getattr map)))
(dontaudit vpud_native default_prop (file (read open getattr map)))
(dontaudit gmscore_app oem_unlock_prop (file (open getattr map)))
(dontaudit gmscore_app vendor_default_prop (file (open getattr map)))
(dontaudit gmscore_app adbd_prop (file (read open getattr map)))
(allow audioserver vendor_default_prop (file (read open getattr map)))
(allow surfaceflinger vendor_default_prop (file (read open getattr map)))
(allow cameraserver vendor_default_prop (file (read open getattr map)))
(allow bip net_dns_prop (file (read open getattr map)))
; hal_fingerprint_default: our own fingerprint property (Silead) - the type is declared right here, CIL
; does not label file paths (file_contexts is separate; for a repackage it too will have to be chcon'd
; by hand onto /vendor/bin/mindone-bootlog.sh and the property file - this .cil only patches the policy).
(type vendor_silead_fp_prop)
(typeattributeset property_type (vendor_silead_fp_prop))
(allow hal_fingerprint_default vendor_silead_fp_prop (property_service (set)))
(dontaudit kernel debugfs_mmc (dir (search)))
(dontaudit init_insmod_sh debugfs_fb (dir (search)))
(dontaudit nfc nfc_data_vendor_file (dir (search)))
(dontaudit init_insmod_sh self (key (write)))
