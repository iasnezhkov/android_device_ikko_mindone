service vendor.fingerprint-mindone /vendor/bin/hw/android.hardware.biometrics.fingerprint-service.mindone
    class late_start
    user system
    group system input uhid

on post-fs-data
    mkdir /data/vendor/fingerprint_mindone 0700 system system
    restorecon_recursive /data/vendor/fingerprint_mindone
