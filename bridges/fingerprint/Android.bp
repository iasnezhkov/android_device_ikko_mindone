package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.mindone",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.mindone.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.mindone.xml"],
    srcs: [
        "FingerprintBridge.cpp",
        "FingerprintHidlConn.cpp",
        "SessionBridge.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.keymaster-V4-ndk",
        "android.hardware.biometrics.fingerprint@2.1",
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: ["-Wall", "-Werror"],
}
