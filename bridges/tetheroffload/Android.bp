cc_binary {
    name: "android.hardware.tetheroffload-service.mindone",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "hw",
    init_rc: ["android.hardware.tetheroffload-service.mindone.rc"],
    vintf_fragments: ["android.hardware.tetheroffload-service.mindone.xml"],
    srcs: [
        "OffloadBridge.cpp",
        "MddpBackend.cpp",
        "FlowParser.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.tetheroffload-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror"],
}
