package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.gatekeeper-service.mindone",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.gatekeeper-service.mindone.rc"],
    vintf_fragments: ["android.hardware.gatekeeper-service.mindone.xml"],
    srcs: [
        "GatekeeperBridge.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.gatekeeper-V1-ndk",
        "android.hardware.security.keymint-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libhardware",
        "liblog",
        "libutils",
    ],
    cflags: ["-Wall", "-Werror"],
}
