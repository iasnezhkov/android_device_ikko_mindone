// mindone 06.09 - pilot HIDL->AIDL bridge (BRIDGES-HIDL-AIDL, ROADMAP par. C):
// AIDL android.hardware.gatekeeper/default (V1) over the stock HIDL gatekeeper@1.0 (TEE trustkernel).
// Review 14.09 (BRIDGES-REVIEW-1409): +GatekeeperHidlConn.cpp (death/reconnect).
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.gatekeeper-service.mindone",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.gatekeeper-service.mindone.rc"],
    vintf_fragments: ["android.hardware.gatekeeper-service.mindone.xml"],
    srcs: [
        "GatekeeperBridge.cpp",
        "GatekeeperHidlConn.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.gatekeeper-V1-ndk",
        "android.hardware.security.keymint-V4-ndk",
        "android.hardware.gatekeeper@1.0",
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: ["-Wall", "-Werror"],
}
