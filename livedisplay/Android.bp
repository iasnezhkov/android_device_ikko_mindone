cc_binary {
    name: "vendor.lineage.livedisplay-service.mindone",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    init_rc: ["service.rc"],
    vintf_fragments: ["service.xml"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libdrm",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    cpp_std: "c++17",
}
