package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "mindone_wfca",
    stem: "wfca",
    vendor: true,
    compile_multilib: "64",
    srcs: ["wfca.c"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-std=gnu11",
    ],
}
