From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iasnezhkov <iasnezhkov@gmail.com>
Date: Sun, 25 Oct 2026 15:52:15 +0900
Subject: [PATCH] Preserve disabled unprivileged BPF policy on kernel 6.12

Enforce and read back disabled policy before loading and before publishing completion. Preserve irreversible policy 1 and retain older-kernel behavior. Deploy together with netd BPF capability and SELinux changes.

diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
--- a/bpf/loader/NetBpfLoad.cpp
+++ b/bpf/loader/NetBpfLoad.cpp
@@ -1428,6 +1428,28 @@
     }
     if (v != len) {
         ALOGE("write('%s', '%s', %d) -> short write [%d]", filename, value, len, v);
+        return false;
+    }
+    return true;
+}
+
+static bool ensureUnprivilegedBpfDisabled() {
+    const char* const path = "/proc/sys/kernel/unprivileged_bpf_disabled";
+    string value;
+    if (!android::base::ReadFileToString(path, &value)) {
+        ALOGE("Unable to read unprivileged BPF policy");
+        return false;
+    }
+    if (value == "1\n") return true;
+    if (value != "0\n" && value != "2\n") {
+        ALOGE("Invalid unprivileged BPF policy value");
+        return false;
+    }
+    if (value == "0\n" && !writeFile(path, "2\n")) return false;
+    value.clear();
+    if (!android::base::ReadFileToString(path, &value) ||
+        (value != "1\n" && value != "2\n")) {
+        ALOGE("Unprivileged BPF policy readback failed");
         return false;
     }
     return true;
@@ -1772,14 +1794,13 @@
     }

     if (runningAsRoot) {
-        // Note: writing this proc file requires being root (always the case on V+)
-
-        // Linux 5.16-rc1 changed the default to 2 (disabled but changeable),
-        // but we need 0 (enabled)
-        // (this writeFile is known to fail on at least 4.19, but always defaults to 0 on
-        // pre-5.13, on 5.13+ it depends on CONFIG_BPF_UNPRIV_DEFAULT_OFF)
-        if (!writeFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n") &&
-            isAtLeastKernelVersion(5, 13)) return 23;
+        if (isAtLeastKernelVersion(6, 12)) {
+            if (!ensureUnprivilegedBpfDisabled()) return 23;
+        } else {
+
+            if (!writeFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n") &&
+                isAtLeastKernelVersion(5, 13)) return 23;
+        }
     }

     if (isAtLeastU) {
@@ -1955,6 +1976,8 @@
     }

     if (argc == 2 && !strcmp(argv[1], "done")) {
+        if (android::bpf::isAtLeastKernelVersion(6, 12) &&
+            !android::bpf::ensureUnprivilegedBpfDisabled()) return 125;
         // we're being re-exec'ed from platform bpfloader to 'finalize' things
         if (!SetProperty("bpf.progs_loaded", "1")) {
             ALOGE("Failed to set bpf.progs_loaded property to 1.");
