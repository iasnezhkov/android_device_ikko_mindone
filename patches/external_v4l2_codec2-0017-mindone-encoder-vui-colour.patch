From f79fc25dcaed6a3d27bdb93adb9b8aebe3112fa2 Mon Sep 17 00:00:00 2001
From: iasnezhkov <iasnezhkov@gmail.com>
Date: Sun, 27 Sep 2026 11:44:37 +0300
Subject: [PATCH 17/17] v4l2: send the default colour description to the
 encoder (HEVC VUI)

The encoder never set colour aspects, so the VCU wrote its own default VUI:
HEVC 1080p output from a BT.709 input was tagged BT601_PAL (CodecRig, 27.09).
The MTK driver takes the description through V4L2_CID_MPEG_MTK_COLOR_DESC,
a U32 array control of 17 elements matching struct mtk_color_desc
(mtk-vcodec-enc.c: cfg.dims = sizeof(struct mtk_color_desc) / sizeof(u32)),
and forwards it as VENC_SET_PARAM_COLOR_DESC. configureDevice() now fills it
from the ColorUtils size-based default aspects converted to ISO values (the
same helpers the decoder path uses) and sets it for H.264 and HEVC; a driver
that rejects it only logs a warning. UNVERIFIED on the device yet.

Change-Id: I37f7f6f5b202b9d6806f9e2747ea356de9efb2b5
---
 v4l2/V4L2Device.cpp                        |  5 +++
 v4l2/V4L2Encoder.cpp                       | 49 ++++++++++++++++++++++
 v4l2/include/v4l2_codec2/v4l2/V4L2Device.h |  1 +
 3 files changed, 55 insertions(+)

diff --git a/v4l2/V4L2Device.cpp b/v4l2/V4L2Device.cpp
index 33824b9..a8f22fd 100644
--- a/v4l2/V4L2Device.cpp
+++ b/v4l2/V4L2Device.cpp
@@ -101,6 +101,11 @@ V4L2ExtCtrl::V4L2ExtCtrl(uint32_t id, int32_t val) : V4L2ExtCtrl(id) {
     ctrl.value = val;
 }
 
+V4L2ExtCtrl::V4L2ExtCtrl(uint32_t id, void* payload, uint32_t payloadSize) : V4L2ExtCtrl(id) {
+    ctrl.size = payloadSize;
+    ctrl.p_u32 = static_cast<__u32*>(payload);
+}
+
 // Class used to store the state of a buffer that should persist between reference creations. This
 // includes:
 // * Result of initial VIDIOC_QUERYBUF ioctl,
diff --git a/v4l2/V4L2Encoder.cpp b/v4l2/V4L2Encoder.cpp
index 820b2fd..9757c92 100644
--- a/v4l2/V4L2Encoder.cpp
+++ b/v4l2/V4L2Encoder.cpp
@@ -15,6 +15,8 @@
 #include <base/files/scoped_file.h>
 #include <base/memory/ptr_util.h>
 #include <log/log.h>
+#include <media/hardware/VideoAPI.h>
+#include <media/stagefright/foundation/ColorUtils.h>
 #include <ui/Rect.h>
 
 #include <v4l2_codec2/common/EncodeHelpers.h>
@@ -47,6 +49,45 @@ size_t GetMaxOutputBufferSize(const ui::Size& size) {
 #define V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR (V4L2_CID_MPEG_BASE + 644)
 #endif
 
+#ifndef V4L2_CID_MPEG_MTK_COLOR_DESC
+#define V4L2_CID_MPEG_MTK_COLOR_DESC (V4L2_CTRL_CLASS_MPEG | 0x2007)
+#endif
+
+struct MtkColorDesc {
+    uint32_t colorPrimaries;
+    uint32_t transformCharacter;
+    uint32_t matrixCoeffs;
+    uint32_t displayPrimariesX[3];
+    uint32_t displayPrimariesY[3];
+    uint32_t whitePointX;
+    uint32_t whitePointY;
+    uint32_t maxDisplayMasteringLuminance;
+    uint32_t minDisplayMasteringLuminance;
+    uint32_t maxContentLightLevel;
+    uint32_t maxPicLightLevel;
+    uint32_t isHdr;
+    uint32_t fullRange;
+};
+
+void fillDefaultMtkColorDesc(const ui::Size& visibleSize, MtkColorDesc* desc) {
+    memset(desc, 0, sizeof(*desc));
+
+    ColorAspects aspects;
+    memset(&aspects, 0, sizeof(aspects));
+    ColorUtils::setDefaultCodecColorAspectsIfNeeded(aspects, visibleSize.width,
+                                                    visibleSize.height);
+
+    int32_t primaries = 0, transfer = 0, coeffs = 0;
+    bool fullRange = false;
+    ColorUtils::convertCodecColorAspectsToIsoAspects(aspects, &primaries, &transfer, &coeffs,
+                                                     &fullRange);
+
+    desc->colorPrimaries = static_cast<uint32_t>(primaries);
+    desc->transformCharacter = static_cast<uint32_t>(transfer);
+    desc->matrixCoeffs = static_cast<uint32_t>(coeffs);
+    desc->fullRange = fullRange ? 1 : 0;
+}
+
 }  // namespace
 
 // static
@@ -649,6 +690,14 @@ bool V4L2Encoder::configureDevice(C2Config::profile_t outputProfile,
                          {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEADER_MODE,
                                       V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME)});
 
+    MtkColorDesc colorDesc;
+    fillDefaultMtkColorDesc(mVisibleSize, &colorDesc);
+    if (!mDevice->setExtCtrls(
+                V4L2_CTRL_CLASS_MPEG,
+                {V4L2ExtCtrl(V4L2_CID_MPEG_MTK_COLOR_DESC, &colorDesc, sizeof(colorDesc))})) {
+        ALOGW("Failed setting default colour description");
+    }
+
     // All controls below are H.264-specific, so we can return here if the profile is not H.264.
     if (outputProfile >= C2Config::PROFILE_AVC_BASELINE &&
         outputProfile <= C2Config::PROFILE_AVC_ENHANCED_MULTIVIEW_DEPTH_HIGH) {
diff --git a/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h b/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
index b243d47..0d8ce02 100644
--- a/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
+++ b/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
@@ -66,6 +66,7 @@ class V4L2DecodeSurface;
 struct V4L2ExtCtrl {
     V4L2ExtCtrl(uint32_t id);
     V4L2ExtCtrl(uint32_t id, int32_t val);
+    V4L2ExtCtrl(uint32_t id, void* payload, uint32_t payloadSize);
     struct v4l2_ext_control ctrl;
 };
 
