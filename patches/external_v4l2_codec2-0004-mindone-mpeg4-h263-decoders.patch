 components/DecodeInterface.cpp                | 47 +++++++++++++++++++
 v4l2/V4L2ComponentCommon.cpp                  | 15 ++++--
 v4l2/V4L2ComponentStore.cpp                   |  6 +++
 v4l2/V4L2Decoder.cpp                          |  3 ++
 v4l2/V4L2Device.cpp                           | 30 ++++++++++++
 .../v4l2_codec2/v4l2/V4L2ComponentCommon.h    |  2 +
 9 files changed, 114 insertions(+), 7 deletions(-)

diff --git a/common/Common.cpp b/common/Common.cpp
index aba4a19..9803a19 100644
--- a/common/Common.cpp
+++ b/common/Common.cpp
@@ -47,6 +47,12 @@ bool isValidProfileForCodec(VideoCodec codec, C2Config::profile_t profile) {
                 (profile <= C2Config::PROFILE_HEVC_3D_MAIN));
     case VideoCodec::AV1:
         return ((profile >= C2Config::PROFILE_AV1_0) && (profile <= C2Config::PROFILE_AV1_2));
+    case VideoCodec::MPEG4:
+        return ((profile >= C2Config::PROFILE_MP4V_SIMPLE) &&
+                (profile <= C2Config::PROFILE_MP4V_FGS));
+    case VideoCodec::H263:
+        return ((profile >= C2Config::PROFILE_H263_BASELINE) &&
+                (profile <= C2Config::PROFILE_H263_HIGH_LATENCY));
     default:
         return false;
     }
diff --git a/common/VideoTypes.cpp b/common/VideoTypes.cpp
index d9f40a9..4afe954 100644
--- a/common/VideoTypes.cpp
+++ b/common/VideoTypes.cpp
@@ -23,6 +23,10 @@ const char* VideoCodecToString(VideoCodec codec) {
         return "HEVC";
     case VideoCodec::AV1:
         return "AV1";
+    case VideoCodec::MPEG4:
+        return "MPEG4";
+    case VideoCodec::H263:
+        return "H263";
     }
 }
 
diff --git a/common/include/v4l2_codec2/common/VideoTypes.h b/common/include/v4l2_codec2/common/VideoTypes.h
index 22ea0bc..350bec9 100644
--- a/common/include/v4l2_codec2/common/VideoTypes.h
+++ b/common/include/v4l2_codec2/common/VideoTypes.h
@@ -20,11 +20,13 @@ enum class VideoCodec {
     VP9,
     HEVC,
     AV1,
+    MPEG4,
+    H263,
 };
 
-constexpr std::initializer_list<VideoCodec> kAllCodecs = {VideoCodec::H264, VideoCodec::VP8,
-                                                          VideoCodec::VP9, VideoCodec::HEVC,
-                                                          VideoCodec::AV1};
+constexpr std::initializer_list<VideoCodec> kAllCodecs = {
+        VideoCodec::H264, VideoCodec::VP8,  VideoCodec::VP9,   VideoCodec::HEVC,
+        VideoCodec::AV1,  VideoCodec::MPEG4, VideoCodec::H263};
 
 const char* VideoCodecToString(VideoCodec codec);
 const char* profileToString(C2Config::profile_t profile);
diff --git a/components/DecodeInterface.cpp b/components/DecodeInterface.cpp
index 558c0ea..1cdfd27 100644
--- a/components/DecodeInterface.cpp
+++ b/components/DecodeInterface.cpp
@@ -158,6 +158,15 @@ DecodeInterface::DecodeInterface(const std::string& name,
         case VideoCodec::AV1:
             profiles = {C2Config::PROFILE_AV1_0};
             break;
+        case VideoCodec::MPEG4:
+            profiles = {
+                    C2Config::PROFILE_MP4V_SIMPLE,
+                    C2Config::PROFILE_MP4V_ADVANCED_SIMPLE,
+            };
+            break;
+        case VideoCodec::H263:
+            profiles = {C2Config::PROFILE_H263_BASELINE};
+            break;
         }
     }
 
@@ -207,6 +216,16 @@ DecodeInterface::DecodeInterface(const std::string& name,
                       C2Config::LEVEL_AV1_6, C2Config::LEVEL_AV1_6_1, C2Config::LEVEL_AV1_6_2, C2Config::LEVEL_AV1_6_3,
                       C2Config::LEVEL_AV1_7, C2Config::LEVEL_AV1_7_1, C2Config::LEVEL_AV1_7_2, C2Config::LEVEL_AV1_7_3};
             break;
+        case VideoCodec::MPEG4:
+            levels = {C2Config::LEVEL_MP4V_0,  C2Config::LEVEL_MP4V_0B, C2Config::LEVEL_MP4V_1,
+                      C2Config::LEVEL_MP4V_2,  C2Config::LEVEL_MP4V_3,  C2Config::LEVEL_MP4V_4,
+                      C2Config::LEVEL_MP4V_5};
+            break;
+        case VideoCodec::H263:
+            levels = {C2Config::LEVEL_H263_10, C2Config::LEVEL_H263_20, C2Config::LEVEL_H263_30,
+                      C2Config::LEVEL_H263_40, C2Config::LEVEL_H263_45, C2Config::LEVEL_H263_50,
+                      C2Config::LEVEL_H263_60, C2Config::LEVEL_H263_70};
+            break;
         }
     }
 
@@ -270,6 +289,30 @@ DecodeInterface::DecodeInterface(const std::string& name,
                              .withSetter(ProfileLevelSetter)
                              .build());
         break;
+
+    case VideoCodec::MPEG4:
+        inputMime = MEDIA_MIMETYPE_VIDEO_MPEG4;
+        addParameter(DefineParam(mProfileLevel, C2_PARAMKEY_PROFILE_LEVEL)
+                             .withDefault(new C2StreamProfileLevelInfo::input(
+                                     0u, static_cast<C2Config::profile_t>(defaultProfile),
+                                     static_cast<C2Config::level_t>(defaultLevel)))
+                             .withFields({C2F(mProfileLevel, profile).oneOf(profiles),
+                                          C2F(mProfileLevel, level).oneOf(levels)})
+                             .withSetter(ProfileLevelSetter)
+                             .build());
+        break;
+
+    case VideoCodec::H263:
+        inputMime = MEDIA_MIMETYPE_VIDEO_H263;
+        addParameter(DefineParam(mProfileLevel, C2_PARAMKEY_PROFILE_LEVEL)
+                             .withDefault(new C2StreamProfileLevelInfo::input(
+                                     0u, static_cast<C2Config::profile_t>(defaultProfile),
+                                     static_cast<C2Config::level_t>(defaultLevel)))
+                             .withFields({C2F(mProfileLevel, profile).oneOf(profiles),
+                                          C2F(mProfileLevel, level).oneOf(levels)})
+                             .withSetter(ProfileLevelSetter)
+                             .build());
+        break;
     }
 
     addParameter(
@@ -472,6 +515,10 @@ uint32_t DecodeInterface::getOutputDelay(VideoCodec codec) {
     case VideoCodec::AV1:
         // Reference: TOTAL_REFS_PER_FRAME at https://aomediacodec.github.io/av1-spec/#symbols-and-abbreviated-terms
         return 8;
+    case VideoCodec::MPEG4:
+        return 4;
+    case VideoCodec::H263:
+        return 2;
     }
 }
 
