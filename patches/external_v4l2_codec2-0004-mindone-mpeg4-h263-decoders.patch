diff --git a/v4l2/V4L2Device.cpp b/v4l2/V4L2Device.cpp
index e8bc773..de47313 100644
--- a/v4l2/V4L2Device.cpp
+++ b/v4l2/V4L2Device.cpp
@@ -62,6 +62,12 @@ bool isValidPixFmtForCodec(VideoCodec codec, uint32_t pixFmt) {
     case V4L2_PIX_FMT_AV1_FRAME:
         return codec == VideoCodec::AV1;
         break;
+    case V4L2_PIX_FMT_MPEG4:
+        return codec == VideoCodec::MPEG4;
+        break;
+    case V4L2_PIX_FMT_H263:
+        return codec == VideoCodec::H263;
+        break;
     default:
         ALOGE("Unhandled pixelformat %s", fourccToString(pixFmt).c_str());
         return false;
@@ -1583,6 +1589,10 @@ uint32_t V4L2Device::videoCodecToPixFmt(VideoCodec codec) {
         return V4L2_PIX_FMT_HEVC;
     case VideoCodec::AV1:
         return V4L2_PIX_FMT_AV1;
+    case VideoCodec::MPEG4:
+        return V4L2_PIX_FMT_MPEG4;
+    case VideoCodec::H263:
+        return V4L2_PIX_FMT_H263;
     }
 }
 
@@ -1680,6 +1690,18 @@ std::vector<C2Config::level_t> V4L2Device::queryC2Levels(uint32_t pixFmt) {
                       C2Config::LEVEL_AV1_7, C2Config::LEVEL_AV1_7_1, C2Config::LEVEL_AV1_7_2, C2Config::LEVEL_AV1_7_3};
         }
         break;
+    case V4L2_PIX_FMT_MPEG4:
+        ALOGW("Driver does not support QUERY MPEG4 levels, use default values, 0-5");
+        levels = {C2Config::LEVEL_MP4V_0,  C2Config::LEVEL_MP4V_0B, C2Config::LEVEL_MP4V_1,
+                  C2Config::LEVEL_MP4V_2,  C2Config::LEVEL_MP4V_3,  C2Config::LEVEL_MP4V_4,
+                  C2Config::LEVEL_MP4V_5};
+        break;
+    case V4L2_PIX_FMT_H263:
+        ALOGW("Driver does not support QUERY H263 levels, use default values, 10-70");
+        levels = {C2Config::LEVEL_H263_10, C2Config::LEVEL_H263_20, C2Config::LEVEL_H263_30,
+                  C2Config::LEVEL_H263_40, C2Config::LEVEL_H263_45, C2Config::LEVEL_H263_50,
+                  C2Config::LEVEL_H263_60, C2Config::LEVEL_H263_70};
+        break;
     default:
         ALOGE("Unhandled pixelformat %s", fourccToString(pixFmt).c_str());
         return {};
@@ -1778,6 +1800,14 @@ std::vector<C2Config::profile_t> V4L2Device::queryC2Profiles(uint32_t pixFmt) {
             profiles = {C2Config::PROFILE_AV1_0};
         }
         break;
+    case V4L2_PIX_FMT_MPEG4:
+        ALOGW("Driver does not support QUERY MPEG4 profiles, use default values, Simple");
+        profiles = {C2Config::PROFILE_MP4V_SIMPLE, C2Config::PROFILE_MP4V_ADVANCED_SIMPLE};
+        break;
+    case V4L2_PIX_FMT_H263:
+        ALOGW("Driver does not support QUERY H263 profiles, use default values, Baseline");
+        profiles = {C2Config::PROFILE_H263_BASELINE};
+        break;
     default:
         ALOGE("Unhandled pixelformat %s", fourccToString(pixFmt).c_str());
         return {};
