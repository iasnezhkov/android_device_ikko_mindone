 aidl/thermal/thermal-helper.cpp        | 31 +++++++++++++++++++++-----
 aidl/thermal/thermal-helper.h          |  1 +
 aidl/thermal/utils/thermal_watcher.cpp | 15 +++++++++++--
 3 files changed, 40 insertions(+), 7 deletions(-)

