@@ -7,8 +7,12 @@
 
 #include <v4l2_codec2/components/VideoFrame.h>
 
+#include <vector>
+
 #include <C2AllocatorGralloc.h>
+#include <cutils/native_handle.h>
 #include <log/log.h>
+#include <ui/GraphicBufferMapper.h>
 
 namespace android {
 
@@ -54,9 +58,53 @@ C2ConstGraphicBlock VideoFrame::getGraphicBlock() {
     return mGraphicBlock->share(C2Rect(mVisibleRect.width(), mVisibleRect.height()), C2Fence());
 }
 
-bool VideoFrame::detileFrom(ImageConverter* converter, const TiledMM21Image& src, int width,
-                            int height) {
-    if (!converter || !mGraphicBlock) {
+bool VideoFrame::detileFrom(ImageConverter* primaryConverter, ImageConverter* fallbackConverter,
+                            const TiledMM21Image& src, int width, int height,
+                            bool* primaryFailed) {
+    if (primaryFailed) {
+        *primaryFailed = false;
+    }
+    if (!mGraphicBlock) {
+        return false;
+    }
+
+    if (primaryConverter) {
+        const C2Handle* const handle = mGraphicBlock->handle();
+        bool queried = false;
+        if (handle && handle->numFds > 0) {
+            std::vector<ui::PlaneLayout> planeLayouts;
+            const status_t err = GraphicBufferMapper::get().getPlaneLayouts(
+                    const_cast<native_handle_t*>(
+                            reinterpret_cast<const native_handle_t*>(handle)),
+                    &planeLayouts);
+            if (err == NO_ERROR && planeLayouts.size() >= 2) {
+                NV12WritableImage dst;
+                dst.dmaBufFd = handle->data[0];
+                dst.strideY = static_cast<size_t>(planeLayouts[0].strideInBytes);
+                dst.offsetY = static_cast<size_t>(planeLayouts[0].offsetInBytes);
+                dst.sizeY = static_cast<size_t>(planeLayouts[0].totalSizeInBytes);
+                dst.strideUV = static_cast<size_t>(planeLayouts[1].strideInBytes);
+                dst.offsetUV = static_cast<size_t>(planeLayouts[1].offsetInBytes);
+                dst.sizeUV = static_cast<size_t>(planeLayouts[1].totalSizeInBytes);
+                queried = true;
+                if (primaryConverter->convertMM21ToNV12(src, dst, width, height)) {
+                    return true;
+                }
+            } else {
+                ALOGE("Failed to query gralloc plane layouts for the zero-copy path, err=%d "
+                      "planes=%zu",
+                      err, planeLayouts.size());
+            }
+        }
+        if (!queried) {
+            ALOGE("Graphic block has no usable native handle for the zero-copy path");
+        }
+        if (primaryFailed) {
+            *primaryFailed = true;
+        }
+    }
+
+    if (!fallbackConverter) {
         return false;
     }
 
@@ -85,7 +133,7 @@ bool VideoFrame::detileFrom(ImageConverter* converter, const TiledMM21Image& src
     dst.strideY = static_cast<size_t>(layout.planes[C2PlanarLayout::PLANE_Y].rowInc);
     dst.strideUV = static_cast<size_t>(layout.planes[C2PlanarLayout::PLANE_U].rowInc);
 
-    return converter->convertMM21ToNV12(src, dst, width, height);
+    return fallbackConverter->convertMM21ToNV12(src, dst, width, height);
 }
 
