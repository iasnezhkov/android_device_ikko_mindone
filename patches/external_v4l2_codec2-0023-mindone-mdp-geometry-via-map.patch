From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iasnezhkov <iasnezhkov@gmail.com>
Date: Mon, 28 Sep 2026 03:36:59 +0300
Subject: [PATCH 23/27] v4l2: take the NV12 plane geometry from the mapped C2
 view, not a gralloc import

Change-Id: I3ef55945182c973867632e2b30f385850d2939a0
---
 components/VideoFrame.cpp | 51 ++++++++++++++-------------------------
 1 file changed, 18 insertions(+), 33 deletions(-)

diff --git a/components/VideoFrame.cpp b/components/VideoFrame.cpp
index c8e2211..8326ae0 100644
--- a/components/VideoFrame.cpp
+++ b/components/VideoFrame.cpp
@@ -11,9 +11,7 @@
 #include <vector>
 
 #include <C2AllocatorGralloc.h>
-#include <cutils/native_handle.h>
 #include <log/log.h>
-#include <ui/GraphicBufferMapper.h>
 
 namespace android {
 
@@ -141,39 +139,26 @@ bool VideoFrame::detileFrom(ImageConverter* primaryConverter, ImageConverter* fa
             key.height = static_cast<int>(allocHeight);
             const bool keyed = key.stride != 0;
             if (!keyed || !lookupNV12PlaneGeometry(key, &geometry)) {
-                native_handle_t* unwrapped = UnwrapNativeCodec2GrallocHandle(handle);
-                buffer_handle_t imported = nullptr;
-                const status_t importErr =
-                        unwrapped ? GraphicBufferMapper::get().importBufferNoValidate(
-                                            unwrapped, &imported)
-                                  : BAD_VALUE;
-                if (unwrapped) {
-                    native_handle_delete(unwrapped);
-                }
-                if (importErr == NO_ERROR) {
-                    std::vector<ui::PlaneLayout> planeLayouts;
-                    const status_t err =
-                            GraphicBufferMapper::get().getPlaneLayouts(imported, &planeLayouts);
-                    if (err == NO_ERROR && planeLayouts.size() >= 2) {
-                        geometry.strideY = static_cast<size_t>(planeLayouts[0].strideInBytes);
-                        geometry.offsetY = static_cast<size_t>(planeLayouts[0].offsetInBytes);
-                        geometry.sizeY = static_cast<size_t>(planeLayouts[0].totalSizeInBytes);
-                        geometry.strideUV = static_cast<size_t>(planeLayouts[1].strideInBytes);
-                        geometry.offsetUV = static_cast<size_t>(planeLayouts[1].offsetInBytes);
-                        geometry.sizeUV = static_cast<size_t>(planeLayouts[1].totalSizeInBytes);
-                        geometry.valid = true;
-                        if (keyed) {
-                            storeNV12PlaneGeometry(key, geometry);
-                        }
-                    } else {
-                        ALOGE("Failed to query gralloc plane layouts for the zero-copy path, "
-                              "err=%d planes=%zu",
-                              err, planeLayouts.size());
+                C2Acquirable<C2GraphicView> writable = mGraphicBlock->map();
+                C2GraphicView view = writable.get();
+                if (view.error() == C2_OK && view.layout().numPlanes >= 2) {
+                    const C2PlanarLayout layout = view.layout();
+                    uint8_t* const* data = view.data();
+                    geometry.strideY =
+                            static_cast<size_t>(layout.planes[C2PlanarLayout::PLANE_Y].rowInc);
+                    geometry.strideUV =
+                            static_cast<size_t>(layout.planes[C2PlanarLayout::PLANE_U].rowInc);
+                    geometry.offsetY = 0;
+                    geometry.offsetUV = static_cast<size_t>(data[C2PlanarLayout::PLANE_U] -
+                                                            data[C2PlanarLayout::PLANE_Y]);
+                    geometry.sizeY = geometry.offsetUV;
+                    geometry.valid = true;
+                    if (keyed) {
+                        storeNV12PlaneGeometry(key, geometry);
                     }
-                    GraphicBufferMapper::get().freeBuffer(imported);
                 } else {
-                    ALOGE("Failed to import the graphic block for the zero-copy path, err=%d",
-                          importErr);
+                    ALOGE("Failed to map the graphic block for the zero-copy path, err=%d",
+                          view.error());
                 }
             }
             if (geometry.valid) {
