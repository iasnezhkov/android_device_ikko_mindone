+                com.android.internal.R.bool.config_powerOffRadioWhenNoActiveSubscription)) {
+            mNoSubscriptionRadioPowerController =
+                    new NoSubscriptionRadioPowerController(this, getLooper());
+        }
+
         mLinkBandwidthEstimator = mTelephonyComponentFactory
                 .inject(LinkBandwidthEstimator.class.getName())
                 .makeLinkBandwidthEstimator(this, getLooper());
@@ -3847,6 +3854,9 @@ public class GsmCdmaPhone extends Phone {
                         + ServiceState.rilServiceStateToString(mTelecomVoiceServiceStateOverride)
                         + ")");
         pw.println(" mUiccApplicationsEnabled=" + mUiccApplicationsEnabled);
+        if (mNoSubscriptionRadioPowerController != null) {
+            mNoSubscriptionRadioPowerController.dump(pw);
+        }
