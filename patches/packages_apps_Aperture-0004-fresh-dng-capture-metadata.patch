diff --git a/app/libs/mindone/filter_camera_core.py b/app/libs/mindone/filter_camera_core.py
new file mode 100644
--- /dev/null
+++ b/app/libs/mindone/filter_camera_core.py
@@ -0,0 +1,38 @@
+import hashlib
+import io
+import sys
+import zipfile
+from pathlib import Path
+
+
+EXPECTED_SHA256 = "7350bb3f9e9b786905d8d2d24ab38a4f6b9c749c95033610da1cca6f60a2115c"
+EXCLUDED = {
+    "androidx/camera/core/imagecapture/DngImage2Disk.class",
+    "androidx/camera/core/imagecapture/DngImage2Disk$In.class",
+}
+
+
+def filter_aar(source, destination):
+    data = Path(source).read_bytes()
+    if hashlib.sha256(data).hexdigest() != EXPECTED_SHA256:
+        raise ValueError("Unexpected CameraX AAR; review source overlay before changing version")
+    with zipfile.ZipFile(io.BytesIO(data)) as aar:
+        classes = io.BytesIO()
+        with zipfile.ZipFile(io.BytesIO(aar.read("classes.jar"))) as original:
+            names = original.namelist()
+            if len(names) != len(set(names)) or not EXCLUDED.issubset(names):
+                raise ValueError("Unexpected CameraX class inventory")
+            with zipfile.ZipFile(classes, "w") as filtered:
+                for entry in original.infolist():
+                    if entry.filename not in EXCLUDED:
+                        filtered.writestr(entry, original.read(entry.filename))
+        with zipfile.ZipFile(destination, "w") as output:
+            for entry in aar.infolist():
+                output.writestr(entry, classes.getvalue() if entry.filename == "classes.jar"
+                                else aar.read(entry.filename))
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        raise SystemExit("usage: filter_camera_core.py INPUT.aar OUTPUT.aar")
+    filter_aar(sys.argv[1], sys.argv[2])
