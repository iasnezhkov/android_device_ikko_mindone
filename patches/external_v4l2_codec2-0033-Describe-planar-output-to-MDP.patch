-                    uint8_t* const* data = view.data();
-                    geometry.strideY =
-                            static_cast<size_t>(layout.planes[C2PlanarLayout::PLANE_Y].rowInc);
-                    geometry.strideUV =
-                            static_cast<size_t>(layout.planes[C2PlanarLayout::PLANE_U].rowInc);
-                    geometry.offsetY = 0;
-                    geometry.offsetUV = static_cast<size_t>(data[C2PlanarLayout::PLANE_U] -
-                                                            data[C2PlanarLayout::PLANE_Y]);
-                    geometry.sizeY = geometry.offsetUV;
-                    geometry.valid = true;
-                    if (keyed) {
-                        storeNV12PlaneGeometry(key, geometry);
-                    }
-                } else {
-                    ALOGE("Failed to map the graphic block for the zero-copy path, err=%d",
-                          view.error());
+                if (readNV12PlaneGeometry(view, static_cast<size_t>(info.st_size),
+                                          width, height, &geometry)) {
+                    storeNV12PlaneGeometry(key, geometry);
                 }
@@ -164,10 +204,4 @@
             if (geometry.valid) {
-                NV12WritableImage dst;
+                NV12WritableImage dst = geometry;
                 dst.dmaBufFd = handle->data[1];
-                dst.strideY = geometry.strideY;
-                dst.offsetY = geometry.offsetY;
-                dst.sizeY = geometry.sizeY;
-                dst.strideUV = geometry.strideUV;
-                dst.offsetUV = geometry.offsetUV;
-                dst.sizeUV = geometry.sizeUV;
                 queried = true;
