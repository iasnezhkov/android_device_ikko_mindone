# Adapted from a LineageOS device tree for the same MT6789
# chipset) — kept largely as-is, these are MediaTek platform-level feature flags (audio/BT/
# camera/sensors/thermal/USB/Widevine), not device-specific. Spot-checked against our own
# facts where we have independent confirmation:
#   vendor.usb.controller=musb-hdrc          — matches our own musb_hdrc driver
#   ro.vendor.mtk_widevine_drm_l3_support=1  — matches F3378 (L3 achievable, L1 architectural dead-end)
# 🔴 NOT individually verified line-by-line against our device (271 lines) — telephony/SIM-count
# props in particular assume a single-SIM device, which is not confirmed for the MindOne.

# Audio
# logd ring sizes (02.09.2026, F2811): the audio HAL floods 'main' at ~92 msg/s and the
# 256 KiB default is gone in 50 s, blinding every post-mortem. persist.logd.size.* is
# ignored on this build (checked 29.08); ro.logd.size.* is read by logd at start.
# Replaces the Magisk script 85-mindone-logsize.sh (rule: no Magisk scripts in the product).
ro.logd.size=64M
ro.logd.size.main=64M
ro.logd.size.system=32M
ro.logd.size.events=16M
ro.logd.size.kernel=16M
ro.logd.size.crash=8M

aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
# 🔴 15.09 (F4461): THIS is what picks the audio HAL. Without it libhardware walks its property
# chain down to ro.board.platform=mt6789 and loads a stock blob - or, in a 64-bit service, finds no
# audio.primary.mt6789.so in /vendor/lib64/hw at all and silently falls back to
# audio.primary.default.so, the STUB, which accepts every write and reports success while the
# kernel sees nothing. That is exactly how ROM 1409 shipped with no sound and no error anywhere.
# Naming our own HAL here makes the choice explicit instead of emergent.
ro.hardware.audio.primary=mindone

ro.vendor.mtk_audio_alac_support=1
ro.vendor.mtk_audio_ape_support=1
ro.vendor.mtk_audio_tuning_tool_ver=V1
ro.vendor.mtk_audio_tuning_tool_ver=V1
ro.vendor.mtk_hifiaudio_support=1
ro.vendor.mtk_hifiaudio_support=1

