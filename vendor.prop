# Display
debug.mediatek.appgamepq_compress=1
debug.mediatek.disp_decompress=1
debug.sf.disable_backpressure=1
# 🔴 The stock values here were 20.0 ms for the app, 27.6 ms for SurfaceFlinger and 23.0 ms as the
# composer minimum. Those describe a 60 Hz pipeline: one vsync period is 16.7 ms there, so 27.6 ms
# is under two periods. This panel runs at 96 Hz and a period is 10.4 ms, which made the composer's
# declared work duration 2.65 periods -- it scheduled composition almost three frames ahead and its
# deadlines stopped lining up. Measured consequence while walking through Settings: the composer
# missed 18 frames a second, the app's frame could not finish because its buffer was not released
# (up to 190 ms) and the next frame therefore started late (up to 175 ms). Input, layout, draw
# recording and the GPU were all fast throughout; only the waiting was slow.
# Sized to the real period instead. Measured on the device over the same navigation, with the
# screen verified on and Settings verified in focus for both runs:
#   90th percentile frame   150 ms -> 25 ms
#   99th percentile frame   200 ms -> 105 ms
#   composer misses         18/s   -> 4.25/s
debug.sf.early.app.duration=10400000
debug.sf.early.sf.duration=10400000
debug.sf.earlyGl.app.duration=10400000
debug.sf.earlyGl.sf.duration=10400000
debug.sf.enable_hwc_vds=0
debug.sf.hwc.min.duration=5000000
debug.sf.late.app.duration=10400000
debug.sf.late.sf.duration=10400000
debug.sf.use_phase_offsets_as_durations=1

# RegionSampling is SurfaceFlinger taking a screenshot of a strip of the display and measuring
# its luminance, so SystemUI can decide whether the status bar icons and the gesture handle
# should be dark or light. It runs on the same RenderEngine thread as composition, and on this
# device a single capture costs up to 88 ms of GPU time.
#
# Measured over 16.3 s of walking through Settings: 76 captures, 820 ms total -- 5% of wall
# time -- and one of them lands inside the worst frame of the run, where the render thread is
# already waiting 160 ms for a buffer and the GPU is 140 ms deep in a fence.
#
# AOSP's default period is 100 ms (RegionSamplingThread.cpp). Five times that keeps the feature
# -- the handle still adapts to what is under it -- and takes the cost to about 1%. The icons
# follow content half a second later than before, which is not noticeable at a glance but is
# the reason this is a number and not an off switch.
debug.sf.region_sampling_period_ns=500000000

# Which layer kinds SurfaceFlinger precompiles shaders for at startup. The switch is in
# device.mk; these narrow what it does. Every "dimmed" variant doubles the set, and shadow and
# picture-in-picture layers are not composed on this device -- dropping them is what makes
# priming affordable, after the full set took 14 581 ms and ANR'd SystemUI on every boot.
debug.sf.prime_shader_cache.clipped_dimmed_image_layers=0
debug.sf.prime_shader_cache.image_dimmed_layers=0
debug.sf.prime_shader_cache.pip_image_layers=0
debug.sf.prime_shader_cache.shadow_layers=0
debug.sf.prime_shader_cache.solid_dimmed_layers=0
debug.sf.prime_shader_cache.transparent_image_dimmed_layers=0
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.protected_contents=true
# MINDONE 12.09 (the project issue registry registry): screen recording does not work - SurfaceFlinger
# does not assign a layer stack to the virtual display (ERROR: UNASSIGNED_LAYER_STACK). Cross-checking against
# the stock default.prop from this device's own vendor_boot ramdisk (the
# "MindOne start"/PRODUCT_DEFAULT_PROPERTY_OVERRIDES block) showed: five HWC/SurfaceFlinger properties
# that stock sets for the mtk_common compositor were MISSING ENTIRELY on our side (grep -c = 0 for
# each one in this file) - the primary display orientation and the composer HAL version, plus two families
# of MTK compositor timings (dynamic_duration, cpupolicy) that the mtk_common blob itself reads,
# not AOSP SurfaceFlinger. It is not proven that these specifically fix virtual displays (F4134/# describes a failure in SF, not in HWC timings), but since they exist in stock and are missing for us -
# this is a divergence from the image the compositor was written for, and a candidate to eliminate FIRST,
# before digging into the SurfaceFlinger code. Restored verbatim from stock.
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.vendor.composer_version=2.1
