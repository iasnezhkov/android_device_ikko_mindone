# 🔴 15.09 (F4456): video telephony OFF. The videotelephony HAL was removed from
# the VINTF manifest on 13.09 ("VoLTE video calling only; stopping it live changed
# nothing else"), but these two properties kept starting its CLIENT
# /system_ext/bin/vtservice, which then retried getTransport for the HAL that is no
# longer declared - every 502 ms, forever: ~172 800 binder calls + 345 600 log lines
# a day, and the CPU never settles. Measured 2.0 lines/s, and exactly 0 after stop.
# volte_support below is VOICE over LTE and is deliberately left ON - different thing.
persist.vendor.vilte_support=0
persist.vendor.viwifi_support=0
persist.vendor.volte_support=1
persist.vendor.xfrm_support=1
ro.telephony.default_network=10,10,10,10
ro.telephony.iwlan_operation_mode=AP-assisted
# MINDONE 12.09 (F4136): ro.telephony.sim.count REMOVED from here - the property is marked
# by AOSP as default_prop (platform-owned), while vendor.prop is loaded by vendor_init, so we get
# avc: denied { set } scontext=vendor_init tcontext=default_prop tclass=property_service
# (device/logs/catch-0911-185910/dmesg.txt.gz). The rule "vendor_init may only write
# vendor-context properties" is a platform neverallow, it cannot be worked around with an allow rule (the same
# class as the reverted changes in sepolicy/vendor/vendor_init.te, F3908). The value has been moved to
# PRODUCT_SYSTEM_PROPERTIES in device.mk - there it is set by init (default_prop is its domain).
# 🔴 ro.telephony.default_network and ro.telephony.iwlan_operation_mode on the line above are the same
# class (also default_prop, also written by vendor_init), but their denial has NOT been
# observed even once in the current logs (likely due to avc caching - the kernel does not repeat an
# identical decision), so I am not touching them without direct proof. If they show up when switching to
# enforcing, move them the same way.
ro.vendor.ap_info_monitor=0
ro.vendor.md_auto_setup_ims=1
ro.vendor.md_prop_ver=1
ro.vendor.mtk_c2k_lte_mode=2
ro.vendor.mtk_c2k_support=1
ro.vendor.mtk_c2k_support=1
ro.vendor.mtk_data_config=1
ro.vendor.mtk_eccci_c2k=1
ro.vendor.mtk_external_sim_only_slots=0
ro.vendor.mtk_fd_support=1
