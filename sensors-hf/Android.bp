package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "mindone_sensors_impl_defaults",
    vendor: true,
    compile_multilib: "64",
    srcs: [
        "Sensors.cpp",
        "HfManagerClient.cpp",
        "SensorTypeMap.cpp",
        "CalibrationStore.cpp",
        "NvcfgJson.cpp",
    ],
    export_include_dirs: ["."],
    header_libs: ["libhardware_legacy_headers"],
    shared_libs: [
        "libbase",
        "liblog",
        "libcutils",
        "libutils",
        "libfmq",
        "libpower",
        "libbinder_ndk",
        "android.hardware.sensors-V3-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_library_static {
    name: "libsensors.mindone.impl",
    defaults: ["mindone_sensors_impl_defaults"],
}

cc_library_static {
    name: "libsensors.mindone.rust.impl",
    defaults: ["mindone_sensors_impl_defaults"],
    cflags: ["-DMINDONE_HF_RUST_WIRE"],
    static_libs: ["libmindone_sensors_wire_ffi"],
}

cc_binary {
    name: "android.hardware.sensors-service.mindone",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "hw",
    init_rc: ["android.hardware.sensors-service.mindone.rc"],
    vintf_fragments: ["mindone-sensors.xml"],
    srcs: ["main.cpp"],
    static_libs: [
        "libsensors.mindone.impl",
    ],
    header_libs: ["libhardware_legacy_headers"],
    shared_libs: [
        "libbase",
        "liblog",
        "libcutils",
        "libutils",
        "libfmq",
        "libpower",
        "libbinder_ndk",
        "android.hardware.sensors-V3-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

rust_library_rlib {
    name: "libmindone_sensors_core",
    crate_name: "mindone_sensors_core",
    vendor: true,
    host_supported: true,
    target: {
        glibc: {
            enabled: false,
        },
    },
    compile_multilib: "64",
    edition: "2021",
    srcs: ["rust/lib.rs"],
    no_stdlibs: true,
    stdlibs: ["libcore.rust_sysroot", "libcompiler_builtins.rust_sysroot"],
}

rust_ffi_static {
    name: "libmindone_sensors_wire_ffi",
    crate_name: "mindone_sensors_wire_ffi",
    vendor: true,
    host_supported: true,
    target: {
        glibc: {
            enabled: false,
        },
    },
    compile_multilib: "64",
    edition: "2021",
    srcs: ["rust/ffi.rs"],
    rustlibs: ["libmindone_sensors_core"],
    prefer_rlib: true,
    export_include_dirs: ["."],
}

rust_test {
    name: "mindone_sensors_core_test",
    crate_name: "mindone_sensors_core_test",
    vendor: true,
    host_supported: true,
    target: {
        glibc: {
            enabled: false,
        },
    },
    compile_multilib: "64",
    edition: "2021",
    srcs: ["tests/core.rs"],
    rustlibs: ["libmindone_sensors_core"],
    prefer_rlib: true,
    test_suites: ["device-tests"],
}
