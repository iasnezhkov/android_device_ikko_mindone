package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "volte_md_status",
    vendor: true,
    compile_multilib: "64",
    srcs: ["volte_md_status.c"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-std=gnu11",
    ],
}
