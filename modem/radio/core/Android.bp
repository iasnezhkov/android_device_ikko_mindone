rust_library_rlib {
    name: "libmindone_radio_core",
    crate_name: "mindone_radio_core",
    srcs: ["lib.rs"],
    edition: "2021",
    vendor: true,
    lints: "none",
    flags: ["-Dwarnings", "-Cpanic=unwind"],
    rustlibs: ["libmindone_radio_at", "libmindone_radio_state", "libmindone_radio_network", "libmindone_radio_modem"],
}
