package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "mindone_mux",
    stem: "gsm0710muxd-c",
    vendor: true,
    compile_multilib: "64",
    srcs: ["mindone_mux.c"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-std=gnu11",
    ],
}

rust_library_rlib {
    lints: "vendor",
    clippy_lints: "vendor",
    name: "libmindone_mux_core",
    crate_name: "mindone_mux_core",
    vendor: true,
    host_supported: true,
    target: {
        glibc: {
            enabled: false,
        },
    },
    compile_multilib: "64",
    edition: "2021",
    srcs: ["lib.rs"],
    no_stdlibs: true,
    stdlibs: ["libcore.rust_sysroot", "libcompiler_builtins.rust_sysroot"],
}

rust_test {
    lints: "vendor",
    clippy_lints: "vendor",
    name: "mindone_mux_core_test",
    crate_name: "mindone_mux_core_test",
    vendor: true,
    host_supported: true,
    target: {
        glibc: {
            enabled: false,
        },
    },
    compile_multilib: "64",
    edition: "2021",
    srcs: ["tests/framing.rs"],
    rustlibs: ["libmindone_mux_core"],
    prefer_rlib: true,
    test_suites: ["device-tests"],
}

