package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "mindone_mux",
    stem: "gsm0710muxd",
    vendor: true,
    compile_multilib: "64",
    srcs: ["mindone_mux.c"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-std=gnu11",
    ],
}
