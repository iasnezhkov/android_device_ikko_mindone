package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "mindone_ccci_daemon_defaults",
    vendor: true,
    compile_multilib: "64",
    local_include_dirs: ["common"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-std=gnu11"],
    // libdl replaces libnvram/libsysenv here: the shim dlopen()s them instead of linking.
    shared_libs: ["liblog", "libcutils", "libdl"],
}

cc_binary {
    name: "mindone_mdinit",
    defaults: ["mindone_ccci_daemon_defaults"],
    srcs: ["mdinit/ccci_mdinit.c", "common/nvram_shim.c"],
}

cc_binary {
    name: "mindone_fsd",
    defaults: ["mindone_ccci_daemon_defaults"],
    srcs: ["fsd/ccci_fsd.c", "common/nvram_shim.c"],
}

cc_binary {
    name: "mindone_rpcd",
    defaults: ["mindone_ccci_daemon_defaults"],
    srcs: ["rpcd/ccci_rpcd.c", "common/nvram_shim.c"],
}
