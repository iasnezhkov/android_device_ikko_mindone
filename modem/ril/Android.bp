// mind_one minimal RIL, phase 1 skeleton. See README-INTEGRATION.md and RIL-MINIMAL-1409.
// Not wired into device/ikko/mindone/ yet -- staged here pending the A/B validation plan in
// README-INTEGRATION.md. 64-bit only, matching this device's vendor partition
// (BOARD_USES_SYSTEM_OTHER / TARGET_ARCH == arm64, no 32-bit vendor libs shipped for new code
// per the project's "english only / 64-bit only" house rules).
cc_binary {
    name: "android.hardware.radio@1.6-service.mindone",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    init_rc: ["init.mindone_ril.rc"],
    vintf_fragments: ["manifest_mindone_ril.xml"],
    srcs: [
        "src/at_tok.c",
        "src/AtChannel.cpp",
        "src/RadioImpl_core.cpp",
        "src/RadioImpl_stubs.cpp",
        "src/service.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "android.hardware.radio@1.0",
        "android.hardware.radio@1.1",
        "android.hardware.radio@1.2",
        "android.hardware.radio@1.3",
        "android.hardware.radio@1.4",
        "android.hardware.radio@1.5",
        "android.hardware.radio@1.6",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
