service mindone_bootlog /vendor/bin/mindone-bootlog.sh
    class core
    user root
    group root system log
    oneshot
    disabled
    seclabel u:r:su:s0

on post-fs && property:persist.vendor.mindone.bootlog=1
    start mindone_bootlog

on boot && property:persist.vendor.mindone.bootlog=1
    start mindone_bootlog
