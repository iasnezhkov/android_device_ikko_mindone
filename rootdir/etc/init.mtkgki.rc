service insmod_sh /vendor/bin/init.insmod.sh /vendor/etc/init.insmod.${ro.hardware}.cfg
    class main
    user root
    group root system
    disabled
    oneshot

service mindone_fast_insmod /vendor/bin/mindone-fast-insmod.sh /vendor/etc/init.insmod.${ro.hardware}.cfg
    class main
    user root
    group root system
    disabled
    oneshot

on early-init
    setprop vendor.all.modules.ready 0
    exec_start mindone_fast_insmod

service mindone_late_insmod /vendor/bin/mindone-fast-insmod.sh --late
    user root
    group root system
    disabled
    oneshot

on property:sys.boot_completed=1
    start mindone_late_insmod
