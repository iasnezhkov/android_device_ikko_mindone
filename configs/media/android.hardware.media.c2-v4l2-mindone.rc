service android-hardware-media-c2-v4l2-hal /vendor/bin/hw/android.hardware.media.c2-service-v4l2
    class hal
    user mediacodec
    group camera drmrpc mediadrm media_rw sdcard_rw media system audio inet net_bt net_bt_admin net_bw_acct sdcard_r
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    setenv MESA_GLSL_CACHE_DISABLE 1
    override
