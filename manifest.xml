<!-- vendor.mediatek.hardware.pq@2.15 (picture-quality service): removed 13.09 — the service never ran on our ROM
     (no pid, no init rc), display works without it; only the service binary + its -impl are dropped, the libpq
     client libraries stay in case hwcomposer/gralloc dlopen them. -->
<!-- vendor.mediatek.hardware.videotelephony@1.0 (vtservice_hidl / vtservice): removed 13.09 with the binaries —
     VoLTE video calling only; stopping it live changed nothing else (probe of the optional services, 13.09). -->
    <!-- sepolicy version intentionally NOT pinned here.
         LineageOS 23 / Android 16 uses date-based sepolicy versions and passes the value
         through BOARD_SEPOLICY_VERS (202504). assemble_vintf refuses to override a version
         already present in the manifest and fails the build with
         "Cannot override existing value 31.0 with BOARD_SEPOLICY_VERS". The 31.0 came from
         the Android 12 vendor manifest this file was derived from.
         NB: the build copies this repository into the LineageOS tree on every build, so the fix
         only survives here - editing the copy inside the VM is wiped at the next run. -->
    <kernel target-level="8"/>
    <!-- 🔴 08.09 (F3930): Silead fingerprint, HIDL 2.1. The entry has to be here specifically, not in a
         separate .xml fragment under vendor/etc/vintf/manifest/: the same install path as the default HAL
         from hardware/interfaces already caused a build break, "overriding commands" (F3769). Without an
         entry in the VINTF manifest the HIDL service does not register at all - the same as seen with
         clientapi in the _b log: "Service ... must be in VINTF manifest". On top of it runs our AIDL->HIDL
         bridge (android.hardware.biometrics.fingerprint-service.mindone), which the A16 framework requires. -->
    <hal format="hidl">
        <name>android.hardware.biometrics.fingerprint</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IBiometricsFingerprint</name>
            <instance>default</instance>
        </interface>
    </hal>
